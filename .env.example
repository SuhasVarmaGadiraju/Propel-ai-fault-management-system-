# ==============================================================================
# Propel AI Fault Detection & Management System - Infrastructure Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=propel_fault_db

# ------------------------------------------------------------------------------
# Backend Flask Application Configuration
# ------------------------------------------------------------------------------
FLASK_ENV=development
FLASK_APP=run.py
SECRET_KEY=propel-fault-management-super-secret-key-change-in-production
BACKEND_PORT=5000

# Full SQLAlchemy Database Connection String
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Allowed CORS Origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# Frontend Vite Application Configuration
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000/api/v1
FRONTEND_PORT=3000
